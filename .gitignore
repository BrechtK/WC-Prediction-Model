# Local Python environments and caches
.venv/
**/__pycache__/
*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
.env

# Temporary Excel files created while a workbook is open
~$*.xlsx
~$*.xlsm
~$*.xls

# Local inputs and generated reports. Keep only directory placeholders tracked.
input/schedule.txt
input/Schedule.txt
input/odds template.txt
input/odds/*.txt
!input/.gitkeep
!input/odds/.gitkeep
input/prepared/
input/historical/
output/
cache/
data/raw/
data/processed/
.pytest_cache/

# Intentionally tracked sample inputs, templates, and parser fixtures
!data/examples/
!data/examples/**
!data/templates/
!data/templates/**
!tests/fixtures/
!tests/fixtures/**
